{
  "name": "watermarker",
  "productName": "Watermarker",
  "desktopName": "watermarker.desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Cross-platform image watermarking desktop app (Electron). See specs/00-INIT-PLAN.md.",
  "author": {
    "name": "Watermarker"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "spike": "node spike/spike.mjs",
    "icon": "node scripts/make-icon.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "font-list": "2.1.0",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@swc/core": "1.16.2",
    "@types/node": "22.20.2",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
